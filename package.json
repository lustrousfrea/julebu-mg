{
  "name": "julebu-mg",
  "version": "1.0.0",
  "private": true,
  "description": "句乐部共享账号状态监控：Cloudflare Worker 后端 + 管理后台 + 浏览器插件",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 migrations apply DB --local",
    "db:init:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit"
  },
  "cloudflare": {
    "label": "句乐部账号管理",
    "products": ["Workers", "D1"],
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "管理后台的登录密码，自己设一个记得住的。"
      },
      "ENCRYPTION_KEY": {
        "description": "用于加密保存的账号密码，随便填一串 32 位以上的随机字符，填好后不要再改。"
      }
    }
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.40.0"
  }
}
